# ---- Shared ----
# SQLite (default, zero-setup). Path is relative to the project root.
DATABASE_URL=sqlite:///data/db.sqlite3
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Secret shared by Django + FastAPI for internal server-to-server calls
INTERNAL_SECRET=change-me-internal

# ---- FastAPI (user panel) ----
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:8000,http://localhost:8001
CURRENCY=usd

# Stripe (leave empty to run in MOCK payment mode for demos)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth0 (leave empty to disable Google/Facebook login)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Email (leave SMTP_HOST empty to print emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
EMAIL_FROM=Smart Shop <no-reply@smartshop.local>

# ---- Django (admin panel) ----
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001
FASTAPI_INTERNAL_URL=http://localhost:8000
PUBLIC_MEDIA_URL=http://localhost:8000/media/
LOW_STOCK_THRESHOLD=5
